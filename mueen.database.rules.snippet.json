{
  "mueen": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "profile": {
          ".validate": "newData.hasChildren(['email'])"
        },
        "items": {
          ".validate": "newData.isList() || !newData.exists()"
        },
        "pushTokens": {
          "$tokenKey": {
            ".validate": "newData.hasChildren(['token','updatedAt']) || !newData.exists()"
          }
        },
        "pushQueue": {
          "$messageId": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['body']) || !newData.exists()"
          }
        }
      }
    }
  }
}