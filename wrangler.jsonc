{
  // This deploys the existing notification Worker, not the GitHub Pages website.
  // Trigger a fresh deployment after the Cloudflare Git repository was connected.
  "name": "ucl-push",
  "main": "cloudflare-worker-v2.js",
  "compatibility_date": "2026-09-20",
  "triggers": {
    "crons": ["* * * * *"]
  }
}
